                "isActive": true
            },
            {
                "id": 43,
                "original": "She <b>was talking</b> on the phone while I <b>was making</b> dinner.",
                "translate": "Она говорила по телефону, пока я готовила ужин. (while — одновременно)",
                "isActive": true
            },
            {
